<Window x:Class="Area850.RoomChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Room"
        Icon="pack://application:,,,/Assets/850.ico"
        Width="780" Height="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}"
        FontFamily="{StaticResource Ui}">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="220"/>
    </Grid.ColumnDefinitions>
    <DockPanel>
      <Border DockPanel.Dock="Top" Background="{DynamicResource Card}" Padding="12,10" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button x:Name="SettingsBtn" Content="Room" Click="Settings_Click" Padding="10,8" Margin="0,0,8,0" Visibility="Collapsed"/>
            <Button x:Name="CamBtn" Content="Start camera" Click="Cam_Click"
                    Background="{DynamicResource Accent}" Foreground="White" Padding="12,8" FontWeight="SemiBold"/>
          </StackPanel>
          <StackPanel>
            <TextBlock x:Name="TitleBlk" FontWeight="SemiBold" FontSize="15"/>
            <TextBlock x:Name="TopicBlk" Text="Hold Ctrl to talk." Foreground="{DynamicResource Sub}" FontSize="12" TextWrapping="Wrap"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <Border DockPanel.Dock="Bottom" Background="{DynamicResource Card}" Padding="10" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
        <DockPanel>
          <Button DockPanel.Dock="Left" Width="36" Height="36" Click="Emoji_Click" ToolTip="Emoji" Margin="0,0,6,0">
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE76E;" FontSize="16"/>
          </Button>
          <Button DockPanel.Dock="Right" Width="52" Click="Send_Click" Background="{DynamicResource Accent}" Foreground="White" Content="➤"/>
          <TextBox x:Name="Composer" KeyDown="Composer_Key" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"/>
        </DockPanel>
      </Border>
      <Popup x:Name="EmojiPop" Placement="Top" PlacementTarget="{Binding ElementName=Composer}" StaysOpen="False">
        <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="8" Width="320">
          <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
            <WrapPanel x:Name="EmojiWrap"/>
          </ScrollViewer>
        </Border>
      </Popup>
      <ScrollViewer x:Name="ChatScroll" Padding="14">
        <StackPanel x:Name="Bubbles"/>
      </ScrollViewer>
    </DockPanel>
    <DockPanel Grid.Column="1" Background="{DynamicResource Card}">
      <Border DockPanel.Dock="Top" Height="168" Background="#111" Margin="8" CornerRadius="6">
        <Grid>
          <Image x:Name="WatchView" Stretch="UniformToFill"/>
          <TextBlock x:Name="WatchLabel" Text="Start camera to see yourself" Foreground="#AAA"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <Border Width="88" Height="66" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6"
                  BorderBrush="White" BorderThickness="1" Background="#000" x:Name="LocalBox" Visibility="Collapsed">
            <Image x:Name="LocalView" Stretch="UniformToFill" RenderTransformOrigin="0.5,0.5">
              <Image.RenderTransform>
                <ScaleTransform ScaleX="-1"/>
              </Image.RenderTransform>
            </Image>
          </Border>
        </Grid>
      </Border>
      <Border x:Name="TalkBtn" DockPanel.Dock="Top" Margin="8,0,8,8" Height="52" CornerRadius="12"
              Background="#27D06C" Cursor="Hand"
              MouseLeftButtonDown="Talk_Down" MouseLeftButtonUp="Talk_Up">
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="TalkLabel" Text="Hold Ctrl to talk" Foreground="White" FontWeight="Bold"
                     FontSize="15" HorizontalAlignment="Center"/>
          <TextBlock Text="or click and hold this bar" Foreground="#E8FFE8" FontSize="11"
                     HorizontalAlignment="Center"/>
        </StackPanel>
      </Border>
      <TextBlock DockPanel.Dock="Top" Margin="10,0,10,4" FontSize="11" Foreground="{DynamicResource Sub}" Text="IN THIS ROOM"/>
      <ListBox x:Name="Occupants" BorderThickness="0" SelectionChanged="Watch_Sel"
               MouseRightButtonUp="Occupants_Right"/>
    </DockPanel>
  </Grid>
</Window>
