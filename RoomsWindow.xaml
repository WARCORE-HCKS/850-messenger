<Window x:Class="Area850.RoomsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chat rooms"
        Icon="pack://application:,,,/Assets/850.ico"
        Width="560" Height="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}"
        FontFamily="{StaticResource Ui}">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="150"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <DockPanel Background="{DynamicResource Card}">
      <TextBlock DockPanel.Dock="Top" Margin="14,14,14,8" FontWeight="SemiBold" Text="CHANNELS"/>
      <ListBox x:Name="Chans" BorderThickness="0" SelectionChanged="Chan_Sel"/>
    </DockPanel>
    <DockPanel Grid.Column="1">
      <Border DockPanel.Dock="Top" Padding="14,12,14,8">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="+ New room" Click="Create_Click"
                  Background="{DynamicResource Accent}" Foreground="White" Padding="12,8" FontWeight="SemiBold"/>
          <StackPanel>
            <TextBlock x:Name="ChanTitle" FontWeight="SemiBold" FontSize="16"/>
            <TextBlock x:Name="ChanSub" Foreground="{DynamicResource Sub}" FontSize="12"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <ListBox x:Name="List" Margin="8,0,8,12" BorderThickness="0"
               MouseDoubleClick="Join_Click" MouseRightButtonUp="List_Right">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="4,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
          </Style>
        </ListBox.ItemContainerStyle>
      </ListBox>
    </DockPanel>
  </Grid>
</Window>
