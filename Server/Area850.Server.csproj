<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>Assets\850-server.ico</ApplicationIcon>
    <AssemblyName>Area850.Server</AssemblyName>
    <RootNamespace>Area850.Server</RootNamespace>
    <Product>850 Server</Product>
    <AssemblyTitle>850 Server</AssemblyTitle>
    <Version>1.1.0</Version>
    <Company>WARCORE</Company>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.8" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
