<Window x:Class="Area850.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="850 Admin"
        Icon="pack://application:,,,/Assets/850.ico"
        Width="780" Height="580"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}"
        FontFamily="{StaticResource Ui}">
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="16,12" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Refresh" Click="Refresh_Click" Padding="12,6"/>
        <StackPanel>
          <TextBlock Text="Admin" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock Text="Only you can see this. Built into the app — no browser." Foreground="{DynamicResource Sub}" FontSize="12"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <TabControl x:Name="Tabs" Margin="12" Background="{DynamicResource Bg}" BorderThickness="0" SelectionChanged="Tabs_Sel">
      <TabItem Header="Overview">
        <DockPanel>
          <UniformGrid DockPanel.Dock="Top" Rows="1" Columns="5" Height="78" Margin="0,0,0,10">
            <Border Background="{DynamicResource Card}" Margin="0,0,8,0" CornerRadius="10" Padding="12">
              <StackPanel>
                <TextBlock x:Name="NOnline" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Accent}" Text="0"/>
                <TextBlock Text="Online" Foreground="{DynamicResource Sub}" FontSize="11"/>
              </StackPanel>
            </Border>
            <Border Background="{DynamicResource Card}" Margin="0,0,8,0" CornerRadius="10" Padding="12">
              <StackPanel>
                <TextBlock x:Name="NUsers" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Accent}" Text="0"/>
                <TextBlock Text="Accounts" Foreground="{DynamicResource Sub}" FontSize="11"/>
              </StackPanel>
            </Border>
            <Border Background="{DynamicResource Card}" Margin="0,0,8,0" CornerRadius="10" Padding="12">
              <StackPanel>
                <TextBlock x:Name="NRooms" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Accent}" Text="0"/>
                <TextBlock Text="Rooms" Foreground="{DynamicResource Sub}" FontSize="11"/>
              </StackPanel>
            </Border>
            <Border Background="{DynamicResource Card}" Margin="0,0,8,0" CornerRadius="10" Padding="12">
              <StackPanel>
                <TextBlock x:Name="NToday" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Accent}" Text="0"/>
                <TextBlock Text="Msgs today" Foreground="{DynamicResource Sub}" FontSize="11"/>
              </StackPanel>
            </Border>
            <Border Background="{DynamicResource Card}" CornerRadius="10" Padding="12">
              <StackPanel>
                <TextBlock x:Name="NGhosts" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Accent}" Text="0"/>
                <TextBlock Text="Ghosts" Foreground="{DynamicResource Sub}" FontSize="11"/>
              </StackPanel>
            </Border>
          </UniformGrid>
          <Button DockPanel.Dock="Bottom" Content="Kick selected" Click="KickSession_Click" Padding="10" Margin="0,8,0,0"/>
          <ListView x:Name="SessionList">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="UIN" DisplayMemberBinding="{Binding Uin}" Width="90"/>
                <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="180"/>
                <GridViewColumn Header="Status" DisplayMemberBinding="{Binding Status}" Width="120"/>
              </GridView>
            </ListView.View>
          </ListView>
        </DockPanel>
      </TabItem>
      <TabItem Header="Users">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="Search" Click="SearchUsers_Click" Padding="12,6" Margin="8,0,0,0"/>
            <TextBox x:Name="UserQ" KeyDown="UserQ_Key"/>
          </DockPanel>
          <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button Content="Password" Click="UserPass_Click" Padding="10,6" Margin="0,0,6,0"/>
            <Button Content="Kick" Click="UserKick_Click" Padding="10,6" Margin="0,0,6,0"/>
            <Button Content="Disable" Click="UserDisable_Click" Padding="10,6" Margin="0,0,6,0"/>
            <Button Content="Enable" Click="UserEnable_Click" Padding="10,6" Margin="0,0,6,0"/>
            <Button Content="Delete" Click="UserDelete_Click" Padding="10,6" Background="#C42B1C" Foreground="White"/>
          </WrapPanel>
          <ListView x:Name="UserList">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="UIN" DisplayMemberBinding="{Binding Uin}" Width="80"/>
                <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="180"/>
                <GridViewColumn Header="Flags" DisplayMemberBinding="{Binding Flags}" Width="140"/>
                <GridViewColumn Header="Created" DisplayMemberBinding="{Binding Created}" Width="120"/>
              </GridView>
            </ListView.View>
          </ListView>
        </DockPanel>
      </TabItem>
      <TabItem Header="Rooms">
        <DockPanel>
          <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button Content="Announce" Click="RoomSay_Click" Padding="10,6" Margin="0,0,6,0"/>
            <Button Content="Lock door" Click="RoomLock_Click" Padding="10,6" Margin="0,0,6,0"/>
            <Button Content="Unlock" Click="RoomUnlock_Click" Padding="10,6" Margin="0,0,6,0"/>
            <Button Content="Clear password" Click="RoomPass_Click" Padding="10,6" Margin="0,0,6,0"/>
            <Button Content="Delete room" Click="RoomDelete_Click" Padding="10,6" Background="#C42B1C" Foreground="White"/>
          </WrapPanel>
          <ListView x:Name="RoomList">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="Room" DisplayMemberBinding="{Binding Title}" Width="160"/>
                <GridViewColumn Header="Channel" DisplayMemberBinding="{Binding Channel}" Width="90"/>
                <GridViewColumn Header="In" DisplayMemberBinding="{Binding Users}" Width="50"/>
                <GridViewColumn Header="Msgs" DisplayMemberBinding="{Binding Messages}" Width="60"/>
                <GridViewColumn Header="Flags" DisplayMemberBinding="{Binding Flags}" Width="160"/>
              </GridView>
            </ListView.View>
          </ListView>
        </DockPanel>
      </TabItem>
      <TabItem Header="Traffic">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="Load" Click="LoadMsgs_Click" Padding="12,6" Margin="8,0,0,0"/>
            <TextBox x:Name="MsgQ" KeyDown="MsgQ_Key"/>
          </DockPanel>
          <ListView x:Name="MsgList">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="When" DisplayMemberBinding="{Binding At}" Width="130"/>
                <GridViewColumn Header="Room" DisplayMemberBinding="{Binding Room}" Width="110"/>
                <GridViewColumn Header="Who" DisplayMemberBinding="{Binding Who}" Width="110"/>
                <GridViewColumn Header="Message" DisplayMemberBinding="{Binding Body}" Width="320"/>
              </GridView>
            </ListView.View>
          </ListView>
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
